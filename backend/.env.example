# ── Backend environment (copy to .env and fill in) ──────────────
# Supabase Postgres connection string.
# Local dev: the Direct connection (port 5432) is fine.
# Deploy (Fly.io / IPv4 networks): use the Transaction pooler string
#   e.g. postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.bihukzxwikvaulwfszvg.supabase.co:5432/postgres

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (minutes)
JWT_EXPIRES_MINUTES=720

# Server port (Fly.io injects PORT; local default 8080)
PORT=8080

# Comma-separated allowed CORS origins for the Flutter web app.
# Use * for local dev; set to your deployed frontend URL in production.
CORS_ORIGINS=*
